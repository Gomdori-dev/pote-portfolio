# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/dist/
/지혜승 사진/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/dev.log
/tmp/

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 작가가 보내준 원본 사진 (배포 대상 아님 — 배포용 사본은 public/artists/)
작가/

# Local reel-making artifacts. These are not part of the site; they live
# outside public/ so they never ship to visitors. (The old PC exhibition
# refresh skipped itself whenever these sat untracked; that task is gone and
# GitHub Actions does the refresh now, but they still don't belong in git.)
make_reel*.py
소셜/인스타그램/*.mp4

# scripts/make-season-audio.py downloads its Wikimedia Commons sources here
/.audio-sources/
__pycache__/

!.env.example
